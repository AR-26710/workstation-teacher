{
  "name": "workstation-teacher",
  "version": "1.0.0",
  "private": true,
  "description": "班主任工作台 · 个人工作台系列第 1 期",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vue-tsc -b --force && vite build",
    "preview": "vite preview",
